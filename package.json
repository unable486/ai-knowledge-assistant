{
  "name": "ai-knowledge-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "eval:retrieval": "tsx scripts/evaluate-retrieval.ts",
    "eval:injection": "tsx scripts/injection-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@huggingface/transformers": "^4.2.0",
    "dompurify": "^3.1.6",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "pinia": "^2.2.2",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.1.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vue-tsc": "^2.0.29"
  }
}
