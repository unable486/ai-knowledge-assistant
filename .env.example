# 中转站（或 Anthropic 官方）的 API Key
ANTHROPIC_API_KEY=

# 可选：使用中转站时填写其接口地址（不要带 /v1 结尾）
# 官方直连时留空即可
# ANTHROPIC_BASE_URL=https://your-relay.example.com

# 可选：默认使用 claude-opus-5
# 中转站若只支持特定模型名，请改成它支持的名称
# ANTHROPIC_MODEL=claude-opus-5

# 可选：默认 API 服务端口为 8787
# PORT=8787

# 可选：默认只监听 127.0.0.1。API 没有认证，绑公网等于把 Key 额度开放给全网。
# 跨机访问请走 nginx 反代或 SSH 隧道，确实要监听公网时才改这里。
# HOST=127.0.0.1
